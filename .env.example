# OpenAI — Required for AI chat (sales widget + consultation chat)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase — Required for storing leads from forms
# Get these at: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin panel access — comma-separated admin emails
ADMIN_EMAILS=admin@ovivo.io
